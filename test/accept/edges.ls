// The largest integers JavaScript holds exactly, every printable character a string may hold, and
// names that look like keywords but aren't reserved.
type Big = Int
type Count = Big
largest: Count = 9007199254740991
smallest: Big = -9007199254740991
printable: String = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~"
async: Int = 1
undefined: Int = 0
again: Count = largest
