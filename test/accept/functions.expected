const id = (x) => x;
export const seven = id(7);
const konst = (x) => (s) => x;
export const three = konst(3)("ignored");
const threeOf = konst(3);
export const alsoThree = threeOf("x");
const rename = (n) => (u) => Object.freeze({ name: n, age: u.age });
const mk = (n) => (a) => Object.freeze({ name: n, age: a });
export const ann = mk("Ann")(42);
export const bob = rename("Bob")(ann);
const nameOf = (u) => u.name;
export const bobName = nameOf(bob);
const apply = (f) => (x) => f(x);
export const five = apply(id)(5);
export const base = 10;
const getBase = (s) => base;
export const ten = getBase("x");
export const x = 1;
const shadow = (x) => x;
export const two = shadow(2);
